 		/// </summary>
 		public Properties Properties { get; } = new Properties("Item");
 
+		/// <summary>
+		/// The client shows durability divided by this value (the packet
+		/// documentation gives 39/42 displayed as 3900). To be confirmed
+		/// against the client.
+		/// </summary>
+		public const int DurabilityScale = 100;
+
+		/// <summary>
+		/// Properties that change during play and are saved with the item.
+		/// </summary>
+		public static readonly string[] SavedProperties = { PropertyName.Reinforce_2, PropertyName.PR, PropertyName.Dur };
+
+		/// <summary>
+		/// Returns the saved properties as "name=value;name=value", or an
+		/// empty string if they all have their default value.
+		/// </summary>
+		public string GetSavedProperties()
+		{
+			var parts = new List<string>();
+			foreach (var name in SavedProperties)
+			{
+				if (!this.Properties.TryGetFloat(name, out var value))
+					continue;
+				parts.Add(name + "=" + value.ToString("R", CultureInfo.InvariantCulture));
+			}
+			return string.Join(";", parts);
+		}
+
+		/// <summary>
+		/// Applies properties saved by GetSavedProperties. Unknown names and
+		/// malformed entries are ignored.
+		/// </summary>
+		public void LoadSavedProperties(string saved)
+		{
+			if (string.IsNullOrWhiteSpace(saved))
+				return;
+
+			foreach (var part in saved.Split(';'))
+			{
+				var pair = part.Split('=');
+				if (pair.Length != 2 || Array.IndexOf(SavedProperties, pair[0]) < 0)
+					continue;
+				if (float.TryParse(pair[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
+					this.Properties.SetFloat(pair[0], value);
+			}
+		}
+
